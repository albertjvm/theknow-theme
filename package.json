{
  "name": "@theknow/theme",
  "version": "0.7.2",
  "description": "Shared design tokens and UI primitives for TheKnow",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./components.css": "./components.css",
    "./civic.css": "./civic.css",
    "./favicon.svg": "./favicon.svg",
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./charts": {
      "types": "./charts.d.ts",
      "default": "./charts.js"
    },
    "./blocs": {
      "types": "./blocs.d.ts",
      "default": "./blocs.js"
    }
  },
  "files": [
    "tokens.css",
    "fonts.css",
    "components.css",
    "civic.css",
    "favicon.svg",
    "react.js",
    "react.d.ts",
    "charts.js",
    "charts.d.ts",
    "blocs.js",
    "blocs.d.ts"
  ],
  "peerDependencies": {
    "react": ">=18",
    "recharts": ">=3"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "recharts": { "optional": true }
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1"
  }
}
